{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "docs-searcher": {
      "description": "docs search agent",
      "model": "github-copilot/claude-sonnet-4.5",
      "prompt": "{file:./prompts/docs-searcher.md}",
      "permission": {
        "read": "allow",
        "bash": "allow",
        "edit": "deny",
        "external_directory": "deny"
      }
    },
    "code-reviewer": {
      "color": "accent",
      "description": "Reviews code for best practices and potential issues",
      "prompt": "{file:../skills/review-agent/SKILL.md}",
      "model": "github-copilot/claude-opus-4.6",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "external_directory": "deny"
      }
    }
  }
}
